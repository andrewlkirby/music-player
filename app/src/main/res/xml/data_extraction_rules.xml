<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+ (dataExtractionRules attribute).
  Excludes the Room database from both cloud backup and device-to-device
  transfers so users always get a fresh scan on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="music_player.db" />
        <exclude domain="database" path="music_player.db-shm" />
        <exclude domain="database" path="music_player.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="music_player.db" />
    </device-transfer>
</data-extraction-rules>
