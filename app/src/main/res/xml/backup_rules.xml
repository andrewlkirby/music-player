<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (fullBackupContent replacement).
  We exclude the Room database from cloud backup so users don't restore
  stale scan data; playback preferences are fine to back up.
-->
<full-backup-content>
    <exclude domain="database" path="music_player.db" />
    <exclude domain="database" path="music_player.db-shm" />
    <exclude domain="database" path="music_player.db-wal" />
</full-backup-content>
